# انسخ هاد الملف باسم .env وعبّيه

# Supabase — نفس رابط المشروع اللي بلوحة التحكم
SUPABASE_URL=https://amqdckslpgornuxmbadv.supabase.co
SUPABASE_KEY=ضع_هنا_المفتاح
# طريقة الدخول: يا مفتاح service_role بـ SUPABASE_KEY،
# يا المفتاح العام (anon) + إيميل وكلمة سر حساب الأدمن:
ADMIN_EMAIL=
ADMIN_PASSWORD=

# بوت تيليجرام للتنبيهات (من @BotFather) ورقم المحادثة اللي بتوصلها التنبيهات
TG_BOT_TOKEN=
TG_CHAT_ID=

# كل قديش دقيقة بيفحص كل الطلاب (الافتراضي 60)
SYNC_MINUTES=60
# ساعة ملخص الصبح (0-23) بتوقيت المنطقة تحت، فاضي = بدون ملخص
DIGEST_HOUR=8
TIMEZONE=Asia/Gaza
